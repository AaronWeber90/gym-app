{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/dist"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noNoninteractiveElementInteractions": "error"
			},
			"correctness": {
				"noSolidDestructuredProps": "error",
				"noUndeclaredDependencies": "error",
				"noUndeclaredVariables": "error",
				"useUniqueElementIds": "error"
			},

			"complexity": {
				"noExcessiveCognitiveComplexity": "error",
				"noExcessiveLinesPerFunction": "error",
				"noExcessiveNestedTestSuites": "error",
				"noVoid": "error",
				"useMaxParams": "error"
			}
		},
		"domains": {
			"solid": "recommended",
			"project": "recommended",
			"test": "recommended"
		}
	},
	"javascript": {
		"globals": ["__APP_VERSION__"],
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
