{
	"compilerOptions": {
		// General
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"target": "ESNext",

		// Modules
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"paths": {
			"@api": ["./src/api/index.ts"]
		},

		// Type Checking & Safety
		"strict": true,
		"skipLibCheck": true,
		"types": ["vite/client"]
	}
}
